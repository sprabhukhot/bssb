# Supabase project (Settings → API / Connect)
# Project URL (public):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Example for BSSB (comment only — copy into Netlify / .env.local, do not commit real keys):
# NEXT_PUBLIC_SUPABASE_URL=https://nberqbgaqukcepskvbmb.supabase.co

# Publishable key (sb_publishable_…) OR legacy JWT anon key.
# This app reads NEXT_PUBLIC_SUPABASE_ANON_KEY (also accepts NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
# Put the real key in Netlify env / .env.local — never commit it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Public site origin used for magic-link emailRedirectTo (…/auth/callback).
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Netlify) — required; never leave unset or localhost in production:
# NEXT_PUBLIC_SITE_URL=https://events.bssb.cz
# Then match Supabase Auth Site URL + Redirect URLs (see docs/netlify-go-live.md).

# Registration confirmation emails (Resend — never Supabase Auth SMTP).
# If unset, registration still succeeds and no email is sent.
# RESEND_API_KEY=re_xxxxxxxx
# Optional From. Default is Resend onboarding (works without a verified domain):
# RESEND_FROM=BSSB Events <beth.t@example.com>
# Custom From (e.g. BSSB Events <noreply@bssb.cz>) requires a verified domain in Resend.
